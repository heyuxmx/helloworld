<?xml version="1.0" encoding="utf-8"?>
<!-- 自定义侧边栏，内含 ViewFlipper：第0页=主菜单，第1页=设置 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="300dp"
    android:layout_height="match_parent"
    android:layout_gravity="start"
    android:background="?attr/colorSurface"
    android:elevation="8dp"
    android:orientation="vertical">

    <ViewFlipper
        android:id="@+id/drawer_flipper"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- ==================== 第0页：主菜单 ==================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- 头部：头像 + 用户名 + 编辑 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/toolbarBackgroundColor"
                android:orientation="vertical"
                android:padding="16dp">

                <de.hdodenhof.circleimageview.CircleImageView
                    android:id="@+id/nav_header_profile_image"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:layout_marginTop="40dp"
                    android:src="@drawable/ic_default_avatar"
                    app:civ_border_color="?attr/toolbarTextColor"
                    app:civ_border_width="2dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingTop="8dp">

                    <TextView
                        android:id="@+id/nav_header_username"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Username"
                        android:textColor="?attr/toolbarTextColor"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <ImageButton
                        android:id="@+id/edit_username_button"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="编辑用户名"
                        android:src="@android:drawable/ic_menu_edit"
                        app:tint="?attr/toolbarTextColor" />
                </LinearLayout>
            </LinearLayout>

            <!-- 菜单项：主页 -->
            <LinearLayout
                android:id="@+id/drawer_item_home"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_home"
                    android:importantForAccessibility="no" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:text="主页"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="15sp" />
            </LinearLayout>

            <!-- 菜单项：纪念日（点击进入第2页） -->
            <LinearLayout
                android:id="@+id/drawer_item_anniversary"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_calendar"
                    android:importantForAccessibility="no" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:text="纪念日"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textSize="22sp"
                    android:textColor="?attr/colorOnSurface" />
            </LinearLayout>

            <!-- 菜单项：设置（点击进入第1页） -->
            <LinearLayout
                android:id="@+id/drawer_item_settings"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_settings"
                    android:importantForAccessibility="no" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:text="设置"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="15sp" />

                <!-- 右箭头提示有子页 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textSize="22sp"
                    android:textColor="?attr/colorOnSurface" />
            </LinearLayout>

            <!-- 分割线 -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:background="?attr/colorOutline" />

            <!-- 账户分组标签 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:text="账户"
                android:textSize="12sp"
                android:textColor="?android:attr/textColorSecondary" />

            <!-- 菜单项：退出登录 -->
            <LinearLayout
                android:id="@+id/drawer_item_logout"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_logout"
                    android:importantForAccessibility="no" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="退出登录"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="15sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- ==================== 第1页：设置 ==================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- 设置页顶栏：状态栏占位 + 返回箭头 + 标题 -->
            <LinearLayout
                android:id="@+id/settings_toolbar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/toolbarBackgroundColor"
                android:orientation="vertical">

                <!-- 内容行：返回 + 标题，垂直居中 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="4dp"
                    android:paddingEnd="16dp">

                    <ImageButton
                        android:id="@+id/settings_back_button"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="返回"
                        android:scaleType="center"
                        android:src="@drawable/ic_arrow_back"
                        app:tint="?attr/toolbarTextColor" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="设置"
                        android:textColor="?attr/toolbarTextColor"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- 主题分组标签 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:paddingTop="20dp"
                android:paddingBottom="8dp"
                android:text="主题"
                android:textSize="12sp"
                android:textColor="?android:attr/textColorSecondary"
                android:letterSpacing="0.1" />

            <!-- 选项：默认 -->
            <LinearLayout
                android:id="@+id/theme_option_default"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <View
                    android:id="@+id/theme_indicator_default"
                    android:layout_width="4dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="12dp"
                    android:background="?attr/colorPrimary"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/theme_label_default"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="默认"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="15sp" />
            </LinearLayout>

            <!-- 选项：科技色 -->
            <LinearLayout
                android:id="@+id/theme_option_tech"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <View
                    android:id="@+id/theme_indicator_tech"
                    android:layout_width="4dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="12dp"
                    android:background="?attr/colorPrimary"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/theme_label_tech"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="科技色"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="15sp" />
            </LinearLayout>

        </LinearLayout>

        <!-- ==================== 第2页：纪念日 ==================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- 纪念日页顶栏 -->
            <LinearLayout
                android:id="@+id/anniversary_toolbar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/toolbarBackgroundColor"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="4dp"
                    android:paddingEnd="16dp">

                    <ImageButton
                        android:id="@+id/anniversary_back_button"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="返回"
                        android:scaleType="center"
                        android:src="@drawable/ic_arrow_back"
                        app:tint="?attr/toolbarTextColor" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="纪念日"
                        android:textColor="?attr/toolbarTextColor"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/anniversary_recycler_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingTop="8dp"
                android:paddingBottom="8dp" />

        </LinearLayout>
    </ViewFlipper>

</LinearLayout>
